# App
APP_NAME=Job Hunt OS
# Local Postgres (run scripts/setup_local_postgres.sh), or sqlite:///./jobhunt.db for a zero-setup file DB.
DATABASE_URL=postgresql+psycopg://rohanroy@localhost:5432/jobhunt
# Optional: run pytest against Postgres instead of throwaway SQLite files.
# TEST_DATABASE_URL=postgresql+psycopg://rohanroy@localhost:5432/jobhunt_test
APP_BASE_URL=http://localhost:8000
CRON_SECRET=change-me
# Accounts. SECRET_KEY encrypts the API keys people save in Settings; keep it stable and private.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALLOW_SIGNUP=true
SESSION_DAYS=30
# Leave blank to set the Secure cookie flag automatically on HTTPS requests.
SESSION_COOKIE_SECURE=

# Every account saves its own API keys in Settings. The *_API_KEY and APIFY_API_TOKEN values in this
# file are only copied (encrypted) into the FIRST account when it signs up; nobody else uses them.

# LLM provider: openai | anthropic | openrouter | mock
LLM_PROVIDER=openrouter

# OpenRouter (recommended low-cost/default path)
# `openrouter/free` dynamically chooses from currently available free models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Optional per-stage overrides. Leave blank to inherit OPENROUTER_MODEL.
OPENROUTER_MODEL_RANK=
OPENROUTER_MODEL_TAILOR=
OPENROUTER_MODEL_REVIEW=
OPENROUTER_MODEL_FOLLOWUP=
# Optional comma-separated model fallbacks, e.g. vendor/model:free,openrouter/free
OPENROUTER_FALLBACK_MODELS=
# Safety switch: prevents accidentally calling a paid OpenRouter model.
OPENROUTER_REQUIRE_FREE=true
OPENROUTER_MAX_TOKENS=5000
# Optional attribution headers recommended by OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Job Hunt OS

# Google ADK / Vertex AI Agent Engine (used by job_hunt_agent)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_AGENT_MODEL=gemini-2.5-flash

# Direct OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Direct Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Job discovery: Apify is the primary Hunter source.
# Create a token in Apify Console -> Settings -> Integrations.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=openclawai/job-board-scraper
APIFY_DATASET_LIMIT=5000

# Safety / workflow
MIN_FIT_SCORE=72
FOLLOWUP_DAYS=5
MAX_JOBS_PER_BATCH=30

# Workflow workers: bounded retries and lease-based crash recovery (PostgreSQL required)
WORKFLOW_MAX_ATTEMPTS=3
WORKFLOW_LEASE_SECONDS=900
WORKFLOW_RETRY_BASE_SECONDS=60
WORKFLOW_RETRY_MAX_SECONDS=3600

# In-app scheduler (starts with FastAPI). Intervals in minutes; 0 disables a job.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULER_LEASE_MINUTES=30
HUNTER_INTERVAL_MINUTES=240
APIFY_SYNC_INTERVAL_MINUTES=5
RANKING_INTERVAL_MINUTES=2
COMPENSATION_INTERVAL_MINUTES=5
APPLICATION_INTERVAL_MINUTES=5
FOLLOWUP_INTERVAL_MINUTES=60
INBOX_INTERVAL_MINUTES=5
ANALYTICS_INTERVAL_MINUTES=60
CLEANUP_INTERVAL_MINUTES=15
RANKING_BATCH_SIZE=20
RANKING_CONCURRENCY=5
COMPENSATION_BATCH_SIZE=50
# Enables POST /api/admin/scheduler/{job}/run with header X-Admin-Token. Leave blank to disable.
ADMIN_TOKEN=

# Tests only: a disposable PostgreSQL database (name must contain "test"; it is wiped)
# TEST_DATABASE_URL=postgresql+psycopg://localhost/jobhunt_test
