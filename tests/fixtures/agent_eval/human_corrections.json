{
 "name": "human_corrections",
 "version": 1,
 "description": "Correction rates from stored facts; the recruiter's outcome reported apart and never counted as a model error. Hand-labelled.",
 "examples": [
  {
   "key": "no-data-is-unknown",
   "inputs": {
    "facts": {}
   },
   "outputs": {
    "human_correction_rate": null,
    "by_signal": {
     "inbox": null,
     "review": null,
     "jd_parser": null
    }
   }
  },
  {
   "key": "inbox-corrections",
   "inputs": {
    "facts": {
     "inbox_events": [
      {
       "method": "LLM",
       "user_corrected": true
      },
      {
       "method": "LLM",
       "user_corrected": false
      },
      {
       "method": "RULE",
       "user_corrected": false
      },
      {
       "method": "LLM",
       "user_corrected": false
      },
      {
       "method": "USER",
       "user_corrected": true
      }
     ]
    }
   },
   "outputs": {
    "human_correction_rate": 0.25,
    "by_signal": {
     "inbox": 0.25
    }
   }
  },
  {
   "key": "rejections-are-not-corrections",
   "inputs": {
    "facts": {
     "approvals": [
      {
       "override": false
      },
      {
       "override": false
      },
      {
       "override": false
      },
      {
       "override": false
      }
     ],
     "applications": [
      {
       "stage": "rejected",
       "applied": true
      },
      {
       "stage": "rejected",
       "applied": true
      },
      {
       "stage": "rejected",
       "applied": true
      },
      {
       "stage": "interviewing",
       "applied": true
      }
     ]
    }
   },
   "outputs": {
    "human_correction_rate": 0.0,
    "by_signal": {
     "review": 0.0
    },
    "recruiter_outcome": {
     "rejected": 3,
     "interview": 1,
     "submitted": 4
    }
   }
  },
  {
   "key": "mixed-signals",
   "inputs": {
    "facts": {
     "inbox_events": [
      {
       "method": "LLM",
       "user_corrected": true
      }
     ],
     "approvals": [
      {
       "override": true
      },
      {
       "override": false
      }
     ],
     "jd_parsed_jobs": 7,
     "jd_corrected_jobs": [
      11
     ]
    }
   },
   "outputs": {
    "human_correction_rate": 0.3,
    "by_signal": {
     "inbox": 1.0,
     "review": 0.5,
     "jd_parser": 0.1429
    }
   }
  },
  {
   "key": "unsubmitted-applications-have-no-outcome",
   "inputs": {
    "facts": {
     "applications": [
      {
       "stage": "rejected",
       "applied": false
      }
     ]
    }
   },
   "outputs": {
    "human_correction_rate": null,
    "recruiter_outcome": {
     "rejected": 0,
     "submitted": 0
    }
   }
  }
 ]
}
