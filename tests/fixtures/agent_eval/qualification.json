{
 "name": "qualification",
 "version": 1,
 "description": "Deterministic admission and hard filters (domain_match, search_scope, ranker.hard_filter_reason). keep=false means hidden or skipped. Unknown values never filter. Hand-labelled.",
 "examples": [
  {
   "key": "domain-own-role",
   "inputs": {
    "check": "domain",
    "job": {
     "title": "Senior Backend Engineer"
    },
    "rules": {
     "domain_excludes": [
      "sales",
      "nurse"
     ],
     "skill_excludes": [
      "java",
      "php"
     ],
     "includes": [
      "platform"
     ],
     "roles": [
      "backend engineer"
     ],
     "skills": [
      "python",
      "go"
     ]
    }
   },
   "outputs": {
    "keep": true
   }
  },
