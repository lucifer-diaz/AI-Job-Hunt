      }
     }
    },
    "resume_id": 11,
    "ranking_id": 7
   },
   "outputs": {
    "lineage_ok": false
   },
   "metadata": {
    "evaluator": "resume_version",
    "note": "A version tailored from an older ranking."
   }
  },
  {
   "key": "lineage-untailored",
   "inputs": {
    "content": {
     "untailored": true
    },
    "resume_id": 11,
    "ranking_id": 7
   },
   "outputs": {
    "lineage_ok": true
   },
   "metadata": {
    "evaluator": "resume_version",
    "note": "Skipped tailoring: the packet is the source resume itself."
   }
  },
  {
   "key": "keywords-all-used",
   "inputs": {
    "targets": {
     "use": [
      {
       "keyword": "Python"
      },
      {
       "keyword": "Kubernetes"
      }
     ]
    },
    "markdown": "# A\n- Built Python services on Kubernetes"
   },
   "outputs": {
    "missing_supported": [],
    "score": 100
   },
   "metadata": {
    "evaluator": "keyword_relevance",
    "note": "Every supported posting term appears."
   }
  },
  {
   "key": "keywords-one-missing",
   "inputs": {
    "targets": {
     "use": [
      {
       "keyword": "Python"
      },
      {
       "keyword": "Kubernetes"
      }
     ]
    },
    "markdown": "# A\n- Built Python services"
   },
   "outputs": {
    "missing_supported": [
     "Kubernetes"
    ],
    "score": 50
   },
   "metadata": {
    "evaluator": "keyword_relevance",
    "note": "A supported term left out is named; nothing unsupported is suggested."
   }
  },
  {
   "key": "keywords-source-resume-ignored",
   "inputs": {
    "targets": {
     "use": [
      {
       "keyword": "Kubernetes"
      }
     ]
    },
    "markdown": "# A\n- Built Python services\n## Source Resume\nKubernetes"
   },
   "outputs": {
    "missing_supported": [
     "Kubernetes"
    ],
    "score": 0
   },
   "metadata": {
    "evaluator": "keyword_relevance",
    "note": "The appended source resume does not count as coverage."
   }
  },
  {
   "key": "reviewer-pass-facts-fail",
   "inputs": {
    "review_decision": "PASS",
    "recommendation": "PASS",
    "fact_issues": 2,
    "lineage_ok": true
   },
   "outputs": {
    "decision": "RETAILOR",
    "disagreement": true
   },
   "metadata": {
    "evaluator": "reviewer_disagreement",
    "note": "The evidence checks overrule a reviewer's PASS."
   }
  },
  {
   "key": "reviewer-pass-lineage-fail",
   "inputs": {
    "review_decision": "PASS",
    "recommendation": "PASS",
    "fact_issues": 0,
    "lineage_ok": false
   },
   "outputs": {
    "decision": "RETAILOR",
    "disagreement": true
   },
   "metadata": {
    "evaluator": "reviewer_disagreement",
    "note": "A version of the wrong resume never passes."
   }
  },
  {
   "key": "reviewer-retailor-agrees",
   "inputs": {
    "review_decision": "RETAILOR",
    "recommendation": "RETAILOR",
    "fact_issues": 1,
    "lineage_ok": true
   },
   "outputs": {
    "decision": "RETAILOR",
    "disagreement": false
   },
   "metadata": {
    "evaluator": "reviewer_disagreement",
    "note": "Both say revise: no disagreement."
   }
  },
  {
   "key": "reviewer-pass-clean",
   "inputs": {
    "review_decision": "PASS",
    "recommendation": "PASS",
    "fact_issues": 0,
    "lineage_ok": true
   },
   "outputs": {
    "decision": "PASS",
    "disagreement": false
   },
   "metadata": {
    "evaluator": "reviewer_disagreement",
    "note": "A clean pass stays a pass."
   }
  },
  {
   "key": "reviewer-skip-human",
   "inputs": {
    "review_decision": "NEEDS_HUMAN",
    "recommendation": "SKIP",
    "fact_issues": 0,
    "lineage_ok": true
   },
   "outputs": {
    "decision": "NEEDS_HUMAN",
    "disagreement": false
   },
   "metadata": {
    "evaluator": "reviewer_disagreement",
    "note": "A reviewer's SKIP goes to a person."
   }
  },
  {
   "key": "loop-pass-first",
   "inputs": {
    "decisions": [
     "PASS"
    ],
    "max_revisions": 2
   },
   "outputs": {
    "passes": 1,
    "final": "PASS",
    "max_revisions": 2
   },
   "metadata": {
    "evaluator": "revision_termination",
    "note": "No revision needed."
   }
  },
  {
   "key": "loop-pass-second",
   "inputs": {
    "decisions": [
     "RETAILOR",
     "PASS"
    ],
    "max_revisions": 2
   },
   "outputs": {
    "passes": 2,
    "final": "PASS",
    "max_revisions": 2
   },
   "metadata": {
    "evaluator": "revision_termination",
    "note": "One revision fixes it."
   }
  },
  {
   "key": "loop-never-passes",
   "inputs": {
    "decisions": [
     "RETAILOR"
    ],
    "max_revisions": 2
   },
   "outputs": {
    "passes": 3,
    "final": "NEEDS_HUMAN",
    "max_revisions": 2
   },
   "metadata": {
    "evaluator": "revision_termination",
    "note": "Always sent back: three passes, then a person; never PASS."
   }
  },
  {
   "key": "loop-no-revisions",
   "inputs": {
    "decisions": [
     "RETAILOR"
    ],
    "max_revisions": 0
   },
   "outputs": {
    "passes": 1,
    "final": "NEEDS_HUMAN",
    "max_revisions": 0
   },
   "metadata": {
    "evaluator": "revision_termination",
    "note": "Revisions off: the first RETAILOR waits for a person."
   }
  },
  {
   "key": "loop-human-decides",
   "inputs": {
    "decisions": [
     "NEEDS_HUMAN"
    ],
    "max_revisions": 2
   },
   "outputs": {
    "passes": 1,
    "final": "NEEDS_HUMAN",
    "max_revisions": 2
   },
   "metadata": {
    "evaluator": "revision_termination",
    "note": "A low score goes to a person at once, without spending revisions."
   }
  },
