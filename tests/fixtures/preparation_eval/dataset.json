{
 "description": "Phase 4 evaluation cases (LangSmith Example shape). Ground truth written by hand; mock providers only.",
 "examples": [
  {
   "key": "grounded-bullets",
   "inputs": {
    "bullets": [
     {
      "role_index": null,
      "text": "Led a team of eight engineers building Python and FastAPI platforms",
      "evidence": "lead"
     }
    ]
   },
   "outputs": {
    "grounding_codes": [
     "UNKNOWN_EVIDENCE",
     "UNCITED_CLAIM",
     "INVENTED_METRIC",
     "INVENTED_SKILL",
     "UNSUPPORTED_TERM"
    ]
   },
   "metadata": {
    "evaluator": "evidence_grounding",
    "note": "A bullet that restates its own verified fact passes every grounding check."
   }
  },
  {
   "key": "unknown-evidence-id",
   "inputs": {
    "bullets": [
     {
      "role_index": null,
      "text": "Led a team of eight engineers building Python and FastAPI platforms",
      "evidence": "missing"
     }
    ]
   },
   "outputs": {
    "expected_codes": [
     "UNKNOWN_EVIDENCE"
    ]
   },
   "metadata": {
    "evaluator": "unsupported_claims",
    "note": "A bullet citing a fact that does not exist is caught."
   }
  },
  {
   "key": "invented-metric",
   "inputs": {
    "bullets": [
     {
      "role_index": null,
      "text": "Led a team of eight engineers and cut cloud costs by 73%",
      "evidence": "lead"
     }
    ]
   },
   "outputs": {
    "expected_codes": [
     "INVENTED_METRIC"
    ]
   },
   "metadata": {
    "evaluator": "unsupported_claims",
    "note": "A number no cited fact states is caught."
   }
  },
  {
   "key": "invented-skill",
   "inputs": {
    "bullets": [],
    "skills": [
     "Python",
     "Rust"
    ]
   },
   "outputs": {
    "expected_codes": [
     "INVENTED_SKILL"
    ]
   },
   "metadata": {
    "evaluator": "unsupported_claims",
    "note": "A skill the source resume and evidence never mention is caught."
   }
  },
  {
   "key": "uncited-claim",
   "inputs": {
    "bullets": [
     {
      "role_index": null,
      "text": "Architected a global payments network for forty million users",
      "evidence": null
     }
    ]
   },
   "outputs": {
    "expected_codes": [
     "UNCITED_CLAIM"
    ]
   },
   "metadata": {
    "evaluator": "unsupported_claims",
    "note": "A new claim with no evidence id is caught."
   }
  },
  {
   "key": "lineage-matches",
   "inputs": {
    "content": {
     "context": {
      "id": 11,
      "fit_analysis": {
       "ranking_id": 7
      }
     }
    },
    "resume_id": 11,
    "ranking_id": 7
   },
   "outputs": {
    "lineage_ok": true
   },
   "metadata": {
    "evaluator": "resume_version",
    "note": "A version tailored from the selected resume and the loaded ranking."
   }
  },
  {
   "key": "lineage-other-resume",
   "inputs": {
    "content": {
     "context": {
      "id": 12,
      "fit_analysis": {
