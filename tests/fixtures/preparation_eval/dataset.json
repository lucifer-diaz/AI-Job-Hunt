      }
     }
    },
    "resume_id": 11,
    "ranking_id": 7
   },
   "outputs": {
    "lineage_ok": false
   },
   "metadata": {
    "evaluator": "resume_version",
    "note": "A version tailored from another resume is not this job's packet."
   }
  },
  {
   "key": "lineage-stale-ranking",
   "inputs": {
    "content": {
     "context": {
      "id": 11,
      "fit_analysis": {
